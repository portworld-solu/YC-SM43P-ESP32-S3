# Customer SDK application Kconfig (open-source board pin map included).

# Safety stubs if component-manager still evaluates LVGL9 optional codec rules.
menu "LVGL9 codec stubs (keep off on LVGL 8.4)"

    config LV_USE_LIBJPEG_TURBO
        bool "Stub: LV_USE_LIBJPEG_TURBO (LVGL9 only)"
        default n

    config LV_USE_LIBPNG
        bool "Stub: LV_USE_LIBPNG (LVGL9 only)"
        default n

    config LV_USE_LZ4
        bool "Stub: LV_USE_LZ4 (LVGL9 only)"
        default n

    config LV_USE_LZ4_INTERNAL
        bool "Stub: LV_USE_LZ4_INTERNAL (LVGL9 only)"
        default n

endmenu

menu "Board: RGB LCD pin mapping"

    comment "RGB data lines (DATA0=LSB). Defaults: B1-B5,G0-G5,R1-R5"
    comment "DATA0-4=B(5,45,48,47,21) DATA5-10=G(14,13,12,11,10,9)"
    comment "DATA11-15=R(46,3,8,18,17)"

    config BOARD_LCD_DATA0_GPIO
        int "DATA0 GPIO (B1)"
        default 5
        range 0 48
    config BOARD_LCD_DATA1_GPIO
        int "DATA1 GPIO (B2)"
        default 45
        range 0 48
    config BOARD_LCD_DATA2_GPIO
        int "DATA2 GPIO (B3)"
        default 48
        range 0 48
    config BOARD_LCD_DATA3_GPIO
        int "DATA3 GPIO (B4)"
        default 47
        range 0 48
    config BOARD_LCD_DATA4_GPIO
        int "DATA4 GPIO (B5)"
        default 21
        range 0 48
    config BOARD_LCD_DATA5_GPIO
        int "DATA5 GPIO (G0)"
        default 14
        range 0 48
    config BOARD_LCD_DATA6_GPIO
        int "DATA6 GPIO (G1)"
        default 13
        range 0 48
    config BOARD_LCD_DATA7_GPIO
        int "DATA7 GPIO (G2)"
        default 12
        range 0 48
    config BOARD_LCD_DATA8_GPIO
        int "DATA8 GPIO (G3)"
        default 11
        range 0 48
    config BOARD_LCD_DATA9_GPIO
        int "DATA9 GPIO (G4)"
        default 10
        range 0 48
    config BOARD_LCD_DATA10_GPIO
        int "DATA10 GPIO (G5)"
        default 9
        range 0 48
    config BOARD_LCD_DATA11_GPIO
        int "DATA11 GPIO (R1)"
        default 46
        range 0 48
    config BOARD_LCD_DATA12_GPIO
        int "DATA12 GPIO (R2)"
        default 3
        range 0 48
    config BOARD_LCD_DATA13_GPIO
        int "DATA13 GPIO (R3)"
        default 8
        range 0 48
    config BOARD_LCD_DATA14_GPIO
        int "DATA14 GPIO (R4)"
        default 18
        range 0 48
    config BOARD_LCD_DATA15_GPIO
        int "DATA15 GPIO (R5)"
        default 17
        range 0 48

    comment "RGB sync / control signals"

    config BOARD_LCD_VSYNC_GPIO
        int "VSYNC GPIO"
        default 39
        range 0 48
    config BOARD_LCD_HSYNC_GPIO
        int "HSYNC GPIO"
        default 38
        range 0 48
    config BOARD_LCD_DE_GPIO
        int "DE GPIO"
