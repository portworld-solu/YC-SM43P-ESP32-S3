# Board profile: 395HSD-class 480×480 RGB + GT911 (via NCA9555)
# Overlay with: SDKCONFIG_DEFAULTS += this file (see root CMakeLists.txt comment)
# Theme packs do NOT override these pins.

# --- RGB parallel bus (DATA0=LSB) ---
# DATA0-4 = B : GPIO 5, 45, 48, 47, 21
# DATA5-10 = G: GPIO 14, 13, 12, 11, 10, 9
# DATA11-15 = R: GPIO 46, 3, 8, 18, 17
CONFIG_BOARD_LCD_DATA0_GPIO=5
CONFIG_BOARD_LCD_DATA1_GPIO=45
CONFIG_BOARD_LCD_DATA2_GPIO=48
CONFIG_BOARD_LCD_DATA3_GPIO=47
CONFIG_BOARD_LCD_DATA4_GPIO=21
CONFIG_BOARD_LCD_DATA5_GPIO=14
CONFIG_BOARD_LCD_DATA6_GPIO=13
CONFIG_BOARD_LCD_DATA7_GPIO=12
CONFIG_BOARD_LCD_DATA8_GPIO=11
CONFIG_BOARD_LCD_DATA9_GPIO=10
CONFIG_BOARD_LCD_DATA10_GPIO=9
CONFIG_BOARD_LCD_DATA11_GPIO=46
CONFIG_BOARD_LCD_DATA12_GPIO=3
CONFIG_BOARD_LCD_DATA13_GPIO=8
CONFIG_BOARD_LCD_DATA14_GPIO=18
CONFIG_BOARD_LCD_DATA15_GPIO=17
CONFIG_BOARD_LCD_VSYNC_GPIO=39
CONFIG_BOARD_LCD_HSYNC_GPIO=38
CONFIG_BOARD_LCD_DE_GPIO=40
CONFIG_BOARD_LCD_PCLK_GPIO=41
CONFIG_BOARD_LCD_DISP_GPIO=-1

# Framebuffer / tear avoidance (see config/sdkconfig.common.defaults)
# CONFIG_BSP_LCD_RGB_BUFFER_NUMS=3
# Touch I2C SCL=GPIO7 SDA=GPIO15 (hardcoded in withthewind_board_lvgl_init)
# Expander NCA9555: LCD 3-wire SPI + RST + backlight PWM + CH390 — see board_io_expander.h
CONFIG_BOARD_ETH_CH390_ENABLE=y
CONFIG_BOARD_ETH_CH390_SPI_HOST_SPI3=y
CONFIG_BOARD_ETH_CH390_SPI_MISO_PIN=1
CONFIG_BOARD_ETH_CH390_SPI_MOSI_PIN=2
CONFIG_BOARD_ETH_CH390_SPI_SCLK_PIN=42
CONFIG_BOARD_ETH_CH390_CS_VIA_IO_EXPANDER=y
CONFIG_BOARD_ETH_CH390_RST_VIA_IO_EXPANDER=y
CONFIG_BOARD_ETH_CH390_INT_PIN=6
CONFIG_BOARD_ETH_CH390_SPI_CLOCK_MHZ=20
